{
  "name": "reiniertutoriales-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev",
    "prepare": "svelte-kit sync",
    "build": "vite build && node scripts/finalize.mjs",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test scripts/*.test.mjs && vitest run"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "24.19.2",
    "jsdom": "30.1.3",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
